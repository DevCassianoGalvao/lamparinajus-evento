# Configuração do envio do formulário (e-mail Brevo + planilha).
# cPanel: copie este arquivo como ".env" na raiz do site (mesma pasta do index.html) e preencha.
#         O .htaccess bloqueia o acesso público ao .env.
# Vercel: cadastre as mesmas variáveis em Settings > Environment Variables.
# NUNCA suba um .env com valores reais para o Git.

# Brevo (Transactional Email)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Advocacia de Sucesso

# Quem recebe cada inscrição
TO_EMAIL=lamparinajus@gmail.com

# Planilha Google Sheets — URL /exec do Apps Script e o mesmo SECRET do apps-script/Code.gs
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=
